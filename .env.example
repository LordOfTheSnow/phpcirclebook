APP_NAME="My Mailing List"
APP_URL="https://list.example.com"
ADMIN_EMAIL="admin@example.com"
HMAC_SECRET="change-me-to-a-long-random-string"
DB_PATH="data/mailinglist.db"
APP_LOCALE="en_US"
# Optional. Timezone used to display stored timestamps (e.g. the admin activity
# log). Any PHP timezone identifier, e.g. "Europe/Berlin", "America/New_York".
# Timestamps are stored in UTC and converted to this zone for display. When unset
# or invalid, the server's default timezone is used.
APP_TIMEZONE="Europe/Berlin"
APP_DESCRIPTION="Describe your mailing list here. This text is shown to visitors on the main page."
# Optional. A footer line shown at the bottom of the main form. Leave empty to hide it.
APP_FOOTER=""
# Optional. Which side of the main form the sidebar appears on: "left" or "right".
# Defaults to "right" when unset or invalid. The sidebar only shows when at least
# one of content/events.md or content/links.md exists and is non-empty.
SIDEBAR_SIDE="right"
# Optional. Logo shown to the left of the app name in the header. Either a filename
# served from public/ (e.g. "logo.png", placed next to favicon.svg) or an absolute
# https URL. The logo auto-scales to the header height and may exceed it by at most
# 40px; when taller than the title, the header row grows and stays vertically
# centred. Defaults to the shipped favicon.svg; leave empty to show no logo.
APP_LOGO="favicon.svg"

# --- Admin tool (public/admin.php) ---
# bcrypt hash of the admin password. Generate with:  php bin/hash-password.php
# Required only if you use the web admin page.
ADMIN_PASSWORD_HASH=""
# Optional. Force the admin session cookie to Secure even when HTTPS auto-detection
# sees plain HTTP (e.g. behind a TLS-terminating proxy). Leave unset for normal setups;
# set to true only if your host terminates TLS upstream and forwards HTTP to PHP.
ADMIN_FORCE_SECURE_COOKIE=false
