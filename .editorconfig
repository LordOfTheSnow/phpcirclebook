root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# PHP follows PSR-12: 4-space indentation.
[*.php]
indent_size = 4

# YAML uses 2-space indentation.
[*.{yml,yaml}]
indent_size = 2

# JSON in this repo (composer.json) uses 4-space indentation, matching Composer's default.
[*.json]
indent_size = 4

[*.md]
indent_size = 2
# Markdown can use trailing spaces for hard line breaks.
trim_trailing_whitespace = false
